<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1E2235"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@mipmap/ic_launcher" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Piggy Vault AI"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_patrimonio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Patrimonio: € --,--"
        android:textColor="#34D399"
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Livello Rischio Caveau"
        android:textColor="#9CA3AF"
        android:textSize="11sp"
        android:layout_marginTop="6dp" />

    <ProgressBar
        android:id="@+id/widget_risk_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:progress="35"
        android:progressTint="#EC4899"
        android:backgroundTint="#374151"
        android:layout_marginTop="3dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="6dp">

        <ImageView
            android:id="@+id/widget_piggy_btn"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_piggy_ai"
            android:background="@drawable/circle_pink_bg"
            android:padding="6dp"
            android:scaleType="fitCenter" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Piggy AI Chat"
            android:textColor="#F472B6"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />
    </LinearLayout>

</LinearLayout>